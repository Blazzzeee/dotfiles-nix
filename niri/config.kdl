// Niri Configuration - Migrated from Hyprland

hotkey-overlay {
    skip-at-startup
    hide-not-bound
}

cursor {
    xcursor-theme "Vimix-cursors"
    xcursor-size 32
}

// Prefer server-side decorations when clients support xdg-decoration.
// This prevents focus-ring/border colors from showing through transparent windows.
prefer-no-csd

input {
    keyboard {
        xkb {
            layout "us"
        }
    }

    touchpad {
        tap
        natural-scroll
        dwt
    }

    focus-follows-mouse
}

output "eDP-1" {
    mode "1920x1200"
    scale 1.0
    position x=0 y=0
}

output "HDMI-A-1" {
    mode "1920x1080"
    position x=0 y=-1080 
}

layout {
    gaps 8
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.67
        proportion 1.0
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#c6a0f6" // Catppuccin Lavender
        inactive-color "#595959aa"
    }

    // border {
    //     width 1
    //     active-color "#c6a0f6" // Catppuccin Lavender
    //     inactive-color "#595959aa"
    // }
}

spawn-at-startup "waybar" "-c" "/home/blazzee/.config/waybar-niri/config.jsonc" "-s" "/home/blazzee/.config/waybar-niri/style.css"
spawn-at-startup "swww-daemon" "--format" "xrgb"
spawn-at-startup "dunst" "-conf" "/home/blazzee/.config/dunst/dunstrc"
spawn-at-startup "swayosd"
spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP"

// Window Rules
// For apps with transparency (e.g. kitty), don't draw the focus ring as a solid background.
window-rule {
    match app-id="kitty"
    draw-border-with-background false
}

window-rule {
    match app-id="kitty" title="^yazi$"
    open-floating true
    default-column-width { proportion 0.5; }
}

window-rule {
    match app-id="Brave" 
    default-column-width { proportion 0.5; }
}


window-rule {
    match app-id="blueman-manager"
    open-floating true
}


window-rule {
    match app-id="transmission"
    open-floating true
}

window-rule {
    match app-id="Brave"
    open-on-workspace "2"
}

window-rule {
    match app-id="Spotify"
    open-on-workspace "5"
}

binds {
    // Modifiers
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Applications
    Mod+Return { spawn "kitty"; }
    Mod+R { spawn "/home/blazzee/.config/scripts/zellij.sh"; }
    Mod+T { spawn "sh" "-c" "pkill waybar; waybar -c ~/.config/waybar-niri/config.jsonc -s ~/.config/waybar-niri/style.css"; }
    Mod+B { spawn "qutebrowser"; }
    Mod+C { close-window; }
    Mod+Shift+Q { quit; }
    Mod+E { spawn "kitty" "yazi"; }
    Mod+F { toggle-window-floating; }
    Mod+X { spawn "/home/blazzee/.config/rofi/powermenu/powermenu.sh"; }
    Mod+Z { maximize-column; }
    // Mod+O { spawn "rofi -show drun"; }
    Mod+O { spawn "sh" "-c" "rofi -show drun"; }
    Mod+A { spawn "/home/blazzee/.config/hypr/scripts/choose-animation.sh"; } // Keeping script, might not work fully but harmless
    Mod+Q { switch-preset-column-width; }

    // Screenshot
    // Print { spawn "sh" "-c" "grim ~/Pictures/screenshot_$(date +%Y-%m-%d_%H-%M-%S).png && notify-send 'Screenshot Captured' 'Saved to ~/Pictures'"; }
    // Shift+Print { spawn "sh" "-c" "grim -g \"$(slurp)\" ~/Pictures/screenshot_area_$(date +%Y-%m-%d_%H-%M-%S).png && notify-send 'Screenshot Captured' 'Area screenshot saved to ~/Pictures'"; }

    // Audio / Brightness
    XF86AudioRaiseVolume { spawn "swayosd" "--output-volume" "raise"; }
    XF86AudioLowerVolume { spawn "swayosd" "--output-volume" "lower"; }
    XF86AudioMute { spawn "swayosd" "--output-volume" "mute-toggle"; }
    XF86AudioMicMute { spawn "swayosd" "--input-volume" "mute-toggle"; }
    XF86MonBrightnessUp { spawn "swayosd" "--brightness" "raise"; }
    XF86MonBrightnessDown { spawn "swayosd" "--brightness" "lower"; }
    XF86AudioNext { spawn "playerctl" "next"; }
    XF86AudioPause { spawn "playerctl" "play-pause"; }
    XF86AudioPlay { spawn "playerctl" "play-pause"; }
    XF86AudioPrev { spawn "playerctl" "previous"; }

    // Focus
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+K { focus-window-up; }
    Mod+J { focus-window-down; }

    // Move
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+J { move-window-down; }
    
    // Niri-specific: Move window to other column
    Mod+Ctrl+H { move-window-to-workspace-down; } // Alternative move logic? Sticking to strict Hyprland mapping where possible.
    // Hyprland: Mod+Shift+Arrows -> movewindow. Niri: move-column / move-window matches well.
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Down { move-window-down; }

    // Resize (Hyprland uses Mod+Ctrl+Arrows)
    Mod+Ctrl+Left { set-column-width "-10%"; }
    Mod+Ctrl+Right { set-column-width "+10%"; }
    Mod+Ctrl+Up { set-window-height "-10%"; }
    Mod+Ctrl+Down { set-window-height "+10%"; }

    // Workspaces
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }

    // Mouse
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }
}
